---
// Hero Section - Static HTML (no hydration needed)
---

<section id="home" class="relative pt-32 pb-16 lg:pt-48 lg:pb-24 overflow-hidden">
    <!-- Cover Background Image -->
    <div class="absolute inset-0 z-0">
        <img src="/หน้าหลัก.png" alt="Cover" class="w-full h-full object-cover opacity-10" />
    </div>
    <div class="absolute top-0 right-0 -mr-20 -mt-20 w-96 h-96 rounded-full bg-nbi-yellow opacity-20 blur-3xl"></div>
    <div class="absolute bottom-0 left-0 -ml-20 -mb-20 w-80 h-80 rounded-full bg-nbi-teal opacity-20 blur-3xl"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="text-center max-w-4xl mx-auto">
            <div class="inline-flex items-center gap-2 px-5 py-2 rounded-full bg-white border border-nbi-green/30 text-nbi-darkblue text-sm font-semibold mb-6 shadow-sm tracking-wider uppercase">
                <span class="w-2 h-2 rounded-full bg-nbi-red animate-pulse"></span>
                NATION-BUILDING INSTITUTE (NBI)
            </div>
            
            <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold tracking-tight text-nbi-darkblue mb-6 leading-tight">
                คนไทยยุคใหม่ <br class="hidden sm:block"/>
                <span class="text-nbi-teal">ดี</span> 
                <span class="text-nbi-yellow">เก่ง</span> 
                <span class="text-nbi-red">กล้า!</span>
            </h1>
            
            <p class="mt-6 text-lg md:text-2xl text-gray-600 mb-10 max-w-3xl mx-auto leading-relaxed">
                ปลุกพลังเยาวชน ร่วมพัฒนาชาติให้เป็นอารยะ สร้างผู้นำการเปลี่ยนแปลงผ่านอุดมการณ์เพื่อส่วนรวม
            </p>
            
            <div class="flex flex-col sm:flex-row justify-center gap-4">
                <a href="#programs" class="bg-nbi-green hover:bg-nbi-olive text-white px-8 py-4 rounded-full font-semibold text-lg transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-1 flex items-center justify-center gap-2">
                    ดูโครงการของเรา <i data-lucide="arrow-right" class="w-5 h-5"></i>
                </a>
            </div>
        </div>
    </div>
</section>
