---
import { getCollection } from 'astro:content';

// Get all news items sorted by date
const newsItems = await getCollection('news');
const sortedNews = newsItems.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Category labels in Thai
const categoryLabels = {
  announcement: 'ประกาศ',
  event: 'กิจกรรม',
  program: 'โครงการ',
  achievement: 'ความสำเร็จ',
};

const categoryColors = {
  announcement: 'bg-nbi-darkblue',
  event: 'bg-nbi-teal',
  program: 'bg-nbi-green',
  achievement: 'bg-nbi-yellow',
};
---

<section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold text-nbi-darkblue mb-4">ข่าวสารและประกาศ</h2>
            <div class="w-24 h-1.5 bg-nbi-teal mx-auto rounded-full mb-4"></div>
            <p class="text-gray-600 text-lg max-w-2xl mx-auto">ติดตามข่าวสาร กิจกรรม และความเคลื่อนไหวล่าสุดจาก NBI Youth Club</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {sortedNews.slice(0, 6).map((item) => (
                <article class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-lg transition-all group">
                    {item.data.image && (
                        <div class="h-48 overflow-hidden">
                            <img 
                                src={item.data.image} 
                                alt={item.data.title}
                                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                            />
                        </div>
                    )}
                    <div class="p-6">
                        <div class="flex items-center gap-3 mb-3">
                            <span class={`px-3 py-1 rounded-full text-white text-xs font-semibold ${categoryColors[item.data.category]}`}>
                                {categoryLabels[item.data.category]}
                            </span>
                            <span class="text-gray-400 text-xs">
                                {item.data.pubDate.toLocaleDateString('th-TH', { 
                                    year: 'numeric', 
                                    month: 'long', 
                                    day: 'numeric' 
                                })}
                            </span>
                        </div>
                        <h3 class="text-xl font-bold text-nbi-darkblue mb-2 line-clamp-2">
                            {item.data.title}
                        </h3>
                        <p class="text-gray-600 text-sm mb-4 line-clamp-3">
                            {item.data.description}
                        </p>
                        <a 
                            href={`/news/${item.slug}`}
                            class="inline-flex items-center gap-2 text-nbi-teal font-semibold hover:text-nbi-darkblue transition-colors"
                        >
                            อ่านเพิ่มเติม <i data-lucide="arrow-right" class="w-4 h-4"></i>
                        </a>
                    </div>
                </article>
            ))}
        </div>

        {sortedNews.length === 0 && (
            <div class="text-center py-12">
                <p class="text-gray-500 text-lg">ยังไม่มีข่าวสารในขณะนี้</p>
            </div>
        )}
    </div>
</section>
