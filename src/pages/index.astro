---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import CoreValues from '../components/CoreValues.astro';
import QuoteBanner from '../components/QuoteBanner.astro';
import VisionSection from '../components/VisionSection.astro';
import ProgramsSection from '../components/ProgramsSection.astro';

export const prerender = true;
---

<BaseLayout title="NBI-YOUTH CLUB | เยาวชนไทย ดี เก่ง กล้า!">
  <!-- Navigation -->
  <Navbar />
  
  <!-- Hero Section -->
  <Hero />

  <!-- Intro Video -->
  <section class="py-20 bg-white" aria-labelledby="intro-video-title">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 id="intro-video-title" class="text-3xl md:text-4xl font-bold text-nbi-darkblue mb-4">วิดีโอแนะนำ NBI Youth Club</h2>
        <div class="w-24 h-1.5 bg-nbi-teal mx-auto rounded-full"></div>
      </div>
      <video class="aspect-video w-full rounded-3xl shadow-lg bg-slate-900" controls playsinline preload="metadata" poster="/หน้าหลัก.png" aria-label="วิดีโอแนะนำ NBI Youth Club">
        <source src="/nbi-youth-club-intro.mp4" type="video/mp4" />
        เบราว์เซอร์ของคุณไม่รองรับวิดีโอ กรุณาเปิดวิดีโอบน YouTube
      </video>
      <div class="flex justify-center mt-6">
        <a href="https://www.youtube.com/watch?v=lJ5oW74XI8U" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full bg-red-600 hover:bg-red-700 text-white px-6 py-3 font-semibold transition-colors shadow-sm" aria-label="ดูวิดีโอแนะนำ NBI Youth Club บน YouTube">
          <i data-lucide="youtube" class="w-5 h-5"></i>
          ดูวิดีโอฉบับเต็มบน YouTube
        </a>
      </div>
    </div>
  </section>

  <!-- Activity Gallery -->
  <section class="py-20 bg-slate-50" aria-labelledby="activity-gallery-title">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-10">
        <p class="text-nbi-teal font-semibold tracking-wider uppercase mb-3">จากค่าย สู่การลงมือทำ</p>
        <h2 id="activity-gallery-title" class="text-3xl md:text-4xl font-bold text-nbi-darkblue mb-4">ภาพกิจกรรมเยาวชนสร้างชาติ</h2>
        <p class="text-gray-600 text-lg leading-relaxed">สัมผัสบรรยากาศการเรียนรู้ การสร้างเครือข่าย และผลงานของเยาวชนจากชมรมทั่วประเทศ</p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <a href="https://www.youtube.com/watch?v=8zsCbgKFtmE" target="_blank" rel="noopener noreferrer" class="group lg:col-span-2 lg:row-span-2 overflow-hidden rounded-3xl bg-nbi-darkblue shadow-sm hover:shadow-lg transition-all">
          <div class="aspect-video bg-[url('/หน้าหลัก.png')] bg-cover bg-center overflow-hidden">
            <img src="https://i.ytimg.com/vi/8zsCbgKFtmE/hqdefault.jpg" alt="บรรยากาศค่ายเยาวชนสร้างชาติ รุ่นที่ 17" width="480" height="360" loading="lazy" decoding="async" onerror="this.style.display='none'" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          </div>
          <div class="p-6 text-white">
            <p class="text-nbi-yellow text-sm font-semibold mb-2">NBI-YOUTH CAMP</p>
            <h3 class="text-2xl font-bold">ค่ายเยาวชนสร้างชาติ รุ่นที่ 17</h3>
          </div>
        </a>

        <a href="https://www.youtube.com/watch?v=KxXDD2VPakI" target="_blank" rel="noopener noreferrer" class="group overflow-hidden rounded-3xl bg-white border border-gray-100 shadow-sm hover:shadow-lg transition-all">
          <div class="aspect-video bg-[url('/หน้าหลัก.png')] bg-cover bg-center overflow-hidden">
            <img src="https://i.ytimg.com/vi/KxXDD2VPakI/hqdefault.jpg" alt="กิจกรรมชมรมเยาวชนสร้างชาติในสถานศึกษา" width="480" height="360" loading="lazy" decoding="async" onerror="this.style.display='none'" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          </div>
          <div class="p-6">
            <p class="text-nbi-teal text-sm font-semibold mb-2">OPEN CLUB</p>
            <h3 class="text-xl font-bold text-nbi-darkblue">ชมรมเยาวชนสร้างชาติในสถานศึกษา</h3>
          </div>
        </a>

        <a href="https://www.youtube.com/watch?v=3Dc9MuVsCsU" target="_blank" rel="noopener noreferrer" class="group overflow-hidden rounded-3xl bg-white border border-gray-100 shadow-sm hover:shadow-lg transition-all lg:col-start-3">
          <div class="aspect-video bg-[url('/หน้าหลัก.png')] bg-cover bg-center overflow-hidden">
            <img src="https://i.ytimg.com/vi/3Dc9MuVsCsU/hqdefault.jpg" alt="เยาวชนร่วมทำกิจกรรมและโครงการ CCS" width="480" height="360" loading="lazy" decoding="async" onerror="this.style.display='none'" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          </div>
          <div class="p-6">
            <p class="text-nbi-green text-sm font-semibold mb-2">CCS & COMMUNITY</p>
            <h3 class="text-xl font-bold text-nbi-darkblue">พลังเยาวชนลงมือพัฒนาชุมชน</h3>
          </div>
        </a>
      </div>
    </div>
  </section>
  
  <!-- Stats Section -->
  <Stats />
  
  <!-- Core Values Section -->
  <CoreValues />
  
  <!-- Quote Banner -->
  <QuoteBanner />
  
  <!-- Vision & Background Section -->
  <VisionSection />
  
  <!-- Programs Section -->
  <ProgramsSection />
  
  <!-- Footer & Contact -->
  <footer id="contact" class="bg-slate-900 text-white pt-20 pb-10 border-t-8 border-nbi-green relative overflow-hidden">
    <!-- Decoration -->
    <div class="absolute bottom-0 right-0 w-96 h-96 bg-nbi-teal/10 rounded-full blur-3xl -mr-20 -mb-20"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-12 mb-16">
        <!-- Branding & About Info -->
        <div class="md:col-span-5">
          <div class="font-bold text-3xl tracking-tighter flex items-center gap-1 mb-6 bg-white p-3 rounded-xl inline-flex shadow-sm">
            <span class="text-nbi-teal">N</span>
            <span class="text-nbi-red">B</span>
            <span class="text-nbi-yellow">I</span>
            <span class="text-nbi-darkblue mx-1">-</span>
            <span class="text-nbi-green">YOUTH</span>
          </div>
          <h4 class="text-xl font-bold mb-3 text-white">สถาบันการสร้างชาติ <br/><span class="text-sm font-normal text-nbi-teal">(Nation-Building Institute - NBI)</span></h4>
          <p class="text-gray-400 mb-6 max-w-sm text-sm leading-relaxed">
            ร่วมสร้างเยาวชนให้เป็นคนดี คนเก่ง คนกล้า เพื่อขับเคลื่อนประเทศไทยให้เติบโตอย่างมั่นคงและยั่งยืน
          </p>
          <div class="flex space-x-4">
            <a href="#" class="w-10 h-10 rounded-full bg-gray-800 flex items-center justify-center text-gray-400 hover:bg-blue-600 hover:text-white transition-all transform hover:-translate-y-1">
              <i data-lucide="facebook" class="w-5 h-5"></i>
            </a>
            <a href="https://www.youtube.com/watch?v=lJ5oW74XI8U" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-gray-800 flex items-center justify-center text-gray-400 hover:bg-red-600 hover:text-white transition-all transform hover:-translate-y-1" aria-label="NBI Youth Club บน YouTube">
              <i data-lucide="youtube" class="w-5 h-5"></i>
            </a>
          </div>
        </div>
        
        <!-- Quick Links -->
        <div class="md:col-span-3">
          <h4 class="text-lg font-bold mb-6 text-white border-b-2 border-nbi-yellow inline-block pb-2">เมนูด่วน</h4>
          <ul class="space-y-3">
            <li><a href="#home" class="text-gray-400 hover:text-nbi-yellow transition-colors flex items-center gap-2 text-sm"><i data-lucide="chevron-right" class="w-4 h-4 text-nbi-teal"></i> หน้าแรก</a></li>
            <li><a href="#about" class="text-gray-400 hover:text-nbi-yellow transition-colors flex items-center gap-2 text-sm"><i data-lucide="chevron-right" class="w-4 h-4 text-nbi-teal"></i> อุดมการณ์</a></li>
            <li><a href="#vision" class="text-gray-400 hover:text-nbi-yellow transition-colors flex items-center gap-2 text-sm"><i data-lucide="chevron-right" class="w-4 h-4 text-nbi-teal"></i> วิสัยทัศน์</a></li>
            <li><a href="#programs" class="text-gray-400 hover:text-nbi-yellow transition-colors flex items-center gap-2 text-sm"><i data-lucide="chevron-right" class="w-4 h-4 text-nbi-teal"></i> โครงการทั้งหมด</a></li>
          </ul>
        </div>

        <!-- Contact Detail -->
        <div class="md:col-span-4">
          <h4 class="text-lg font-bold mb-6 text-white border-b-2 border-nbi-red inline-block pb-2">ติดต่อสถาบันฯ</h4>
          <ul class="space-y-5">
            <li class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-full bg-gray-800 flex items-center justify-center flex-shrink-0 mt-1">
                <i data-lucide="map-pin" class="w-5 h-5 text-nbi-red"></i>
              </div>
              <span class="text-gray-400 text-sm leading-relaxed pt-1">
                87/110 อาคารโมเดิร์นทาวน์ ซอยสุขุมวิท 63 แขวงคลองตันเหนือ เขตวัฒนา กรุงเทพฯ 10110
              </span>
            </li>
            <li class="flex items-center gap-4">
              <div class="w-10 h-10 rounded-full bg-gray-800 flex items-center justify-center flex-shrink-0">
                <i data-lucide="phone" class="w-5 h-5 text-nbi-green"></i>
              </div>
              <span class="text-gray-400 text-sm font-medium tracking-wide">
                02-711-7474, 082-984-0118
              </span>
            </li>
            <li class="flex items-center gap-4">
              <div class="w-10 h-10 rounded-full bg-gray-800 flex items-center justify-center flex-shrink-0">
                <i data-lucide="mail" class="w-5 h-5 text-nbi-yellow"></i>
              </div>
              <a href="mailto:nbiyes19@gmail.com" class="text-gray-400 hover:text-white transition-colors text-sm">
                nbiyes19@gmail.com
              </a>
            </li>
          </ul>
        </div>
      </div>
      
      <!-- Copyright -->
      <div class="border-t border-gray-800 pt-8 flex flex-col md:flex-row justify-between items-center text-sm text-gray-500">
        <p class="text-center md:text-left mb-4 md:mb-0">
          &copy; <span id="year"></span> NATION-BUILDING INSTITUTE. สงวนลิขสิทธิ์.
        </p>
        <div class="flex gap-6">
          <a href="#" class="hover:text-white transition-colors">นโยบายความเป็นส่วนตัว</a>
          <a href="#" class="hover:text-white transition-colors">เงื่อนไขการใช้งาน</a>
        </div>
      </div>
    </div>
  </footer>
  
  <!-- Scripts -->
  <script>
    // Set current year
    const yearElement = document.getElementById('year');
    if (yearElement) {
      yearElement.textContent = new Date().getFullYear();
    }

    // Navbar blur effect on scroll
    window.addEventListener('scroll', () => {
      const nav = document.querySelector('nav');
      if (nav) {
        if (window.scrollY > 10) {
          nav.classList.add('shadow-sm');
          nav.classList.replace('border-transparent', 'border-gray-100');
        } else {
          nav.classList.remove('shadow-sm');
          nav.classList.replace('border-gray-100', 'border-transparent');
        }
      }
    });
  </script>
</BaseLayout>
