---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const newsItems = await getCollection('news');
  return newsItems.map((item) => ({
    params: { slug: item.slug },
    props: { entry: item },
  }));
}

const { entry } = Astro.props;
const { title, description, pubDate, author, image, category } = entry.data;

const categoryLabels = {
  announcement: 'ประกาศ',
  event: 'กิจกรรม',
  program: 'โครงการ',
  achievement: 'ความสำเร็จ',
};
---

<BaseLayout title={`${title} | NBI-YOUTH CLUB`} description={description}>
  <article class="min-h-screen bg-white">
    <!-- Hero Image -->
    {image && (
      <div class="w-full h-96 overflow-hidden">
        <img 
          src={image} 
          alt={title}
          class="w-full h-full object-cover"
        />
      </div>
    )}
    
    <!-- Content -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <!-- Meta Info -->
      <div class="flex items-center gap-4 mb-6">
        <span class="px-4 py-1.5 bg-nbi-teal text-white rounded-full text-sm font-semibold">
          {categoryLabels[category]}
        </span>
        <time class="text-gray-500" datetime={pubDate.toISOString()}>
          {pubDate.toLocaleDateString('th-TH', { 
            year: 'numeric', 
            month: 'long', 
            day: 'numeric' 
          })}
        </time>
        {author && (
          <span class="text-gray-500">• โดย {author}</span>
        )}
      </div>
      
      <!-- Title -->
      <h1 class="text-4xl md:text-5xl font-bold text-nbi-darkblue mb-8">
        {title}
      </h1>
      
      <!-- Article Body -->
      <div class="prose prose-lg max-w-none">
        <slot />
      </div>
      
      <!-- Back Link -->
      <div class="mt-16 pt-8 border-t border-gray-200">
        <a 
          href="/#news" 
          class="inline-flex items-center gap-2 text-nbi-teal font-semibold hover:text-nbi-darkblue transition-colors"
        >
          <i data-lucide="arrow-left" class="w-5 h-5"></i> กลับไปหน้าข่าวสาร
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
